   "source": [
    "f=open(\"students.csv\",\"r\")\n",
    "text=f.read()\n",
    "lines=text.split(\"\\n\")\n",
    "for line in lines:\n",
    "    if line.strip()!=\"\":\n",
    "        parts=line.split(\",\")\n",
    "        name=parts[0]\n",
    "        age=parts[1]\n",
    "        grade=parts[2]\n",
    "        print(f\"Name: {name}, Age: {age}, Grade: {grade}\")\n",
    "\n",
